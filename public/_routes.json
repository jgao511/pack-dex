{
  "version": 1,
  "include": [
    "/mobile-app",
    "/mobile-app/*"
  ],
  "exclude": [
    "/mobile-app/assets/*",
    "/mobile-app/generated/*",
    "/mobile-app/scanner-ai/*",
    "/mobile-app/set-logos/*",
    "/mobile-app/index.html",
    "/mobile-app/404.html",
